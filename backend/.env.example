PORT=28200
NODE_ENV=development

# PostgreSQL (create the database first:  createdb hrms)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrms
DB_USER=postgres
DB_PASSWORD=yabu3811

# JWT secret: leave empty in development - it is generated and saved here on first start. REQUIRED (32+ chars) in production.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# First super administrator (used only by npm run seed:admin)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

PUBLIC_URL=http://localhost:5180
CORS_ORIGIN=

# Where employee documents and CVs are stored (outside the web root). Back this folder up together with the database.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# Real staff accounts (used only by npm run users:replace-demo)
STAFF_HR_LEADER_EMAIL=
STAFF_HR_EXPERT_EMAIL=
STAFF_SECRETARY_EMAIL=

# Password for npm run seed:demo accounts (never use in production)
SEED_PASSWORD=Dev@12345678

# E-mail (Gmail). Leave GMAIL_APP_PASSWORD empty = TEST MODE (mails are logged, shown as simulated).
GMAIL_USER=yeabsratizazu@gmail.com
GMAIL_APP_PASSWORD=elryekrihmjytdtu
SMTP_PORT=587
